<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.system.mapper.TzImagePresetMapper">

    <resultMap type="TzImagePreset" id="TzImagePresetResult">
        <result property="presetId"        column="preset_id"        />
        <result property="imageHash"       column="image_hash"       />
        <result property="imageName"       column="image_name"       />
        <result property="imageUrl"        column="image_url"        />
        <result property="cropType"        column="crop_type"        />
        <result property="diagnosisName"   column="diagnosis_name"   />
        <result property="symptomText"     column="symptom_text"     />
        <result property="confidence"      column="confidence"       />
        <result property="riskLevel"       column="risk_level"       />
        <result property="diagnosisBasis"  column="diagnosis_basis"  />
        <result property="knowledgeId"     column="knowledge_id"     />
        <result property="status"          column="status"           />
        <result property="createBy"        column="create_by"        />
        <result property="createTime"      column="create_time"      />
        <result property="updateBy"        column="update_by"        />
        <result property="updateTime"      column="update_time"      />
        <result property="remark"          column="remark"           />
    </resultMap>

    <sql id="selectTzImagePresetVo">
        select preset_id, image_hash, image_name, image_url, crop_type, diagnosis_name,
               symptom_text, confidence,
               risk_level, diagnosis_basis, knowledge_id, status,
               create_by, create_time, update_by, update_time, remark
        from tz_image_preset
    </sql>

    <select id="selectTzImagePresetById" parameterType="Long" resultMap="TzImagePresetResult">
        <include refid="selectTzImagePresetVo"/>
        where preset_id = #{presetId}
    </select>

    <select id="selectTzImagePresetList" parameterType="TzImagePreset" resultMap="TzImagePresetResult">
        <include refid="selectTzImagePresetVo"/>
        <where>
            <if test="imageHash != null and imageHash != ''">
                AND image_hash = #{imageHash}
            </if>
            <if test="imageName != null and imageName != ''">
                AND image_name like concat('%', #{imageName}, '%')
            </if>
            <if test="diagnosisName != null and diagnosisName != ''">
                AND diagnosis_name like concat('%', #{diagnosisName}, '%')
            </if>
            <if test="cropType != null and cropType != ''">
                AND crop_type = #{cropType}
            </if>
            <if test="status != null and status != ''">
                AND status = #{status}
            </if>
        </where>
        order by preset_id desc
    </select>

    <!-- 路线 A 保底查表：同图必得同结论 -->
    <select id="selectTzImagePresetByHash" parameterType="String" resultMap="TzImagePresetResult">
        <include refid="selectTzImagePresetVo"/>
        where image_hash = #{imageHash} and status = '0'
        order by preset_id asc
        limit 1
    </select>

    <insert id="insertTzImagePreset" parameterType="TzImagePreset" useGeneratedKeys="true" keyProperty="presetId">
        insert into tz_image_preset (
            <if test="imageHash != null and imageHash != ''">image_hash, </if>
            <if test="imageName != null and imageName != ''">image_name, </if>
            <if test="imageUrl != null and imageUrl != ''">image_url, </if>
            <if test="cropType != null and cropType != ''">crop_type, </if>
            <if test="diagnosisName != null and diagnosisName != ''">diagnosis_name, </if>
            <if test="symptomText != null and symptomText != ''">symptom_text, </if>
            <if test="confidence != null">confidence, </if>
            <if test="riskLevel != null and riskLevel != ''">risk_level, </if>
            <if test="diagnosisBasis != null and diagnosisBasis != ''">diagnosis_basis, </if>
            <if test="knowledgeId != null">knowledge_id, </if>
            <if test="status != null and status != ''">status, </if>
            <if test="remark != null and remark != ''">remark, </if>
            <if test="createBy != null and createBy != ''">create_by, </if>
            create_time
        )values(
            <if test="imageHash != null and imageHash != ''">#{imageHash}, </if>
            <if test="imageName != null and imageName != ''">#{imageName}, </if>
            <if test="imageUrl != null and imageUrl != ''">#{imageUrl}, </if>
            <if test="cropType != null and cropType != ''">#{cropType}, </if>
            <if test="diagnosisName != null and diagnosisName != ''">#{diagnosisName}, </if>
            <if test="confidence != null">#{confidence}, </if>
            <if test="riskLevel != null and riskLevel != ''">#{riskLevel}, </if>
            <if test="diagnosisBasis != null and diagnosisBasis != ''">#{diagnosisBasis}, </if>
            <if test="knowledgeId != null">#{knowledgeId}, </if>
            <if test="status != null and status != ''">#{status}, </if>
            <if test="remark != null and remark != ''">#{remark}, </if>
            <if test="createBy != null and createBy != ''">#{createBy}, </if>
            sysdate()
        )
    </insert>

    <update id="updateTzImagePreset" parameterType="TzImagePreset">
        update tz_image_preset
        <set>
            <if test="imageHash != null and imageHash != ''">image_hash = #{imageHash}, </if>
            <if test="imageName != null">image_name = #{imageName}, </if>
            <if test="imageUrl != null">image_url = #{imageUrl}, </if>
            <if test="cropType != null and cropType != ''">crop_type = #{cropType}, </if>
            <if test="diagnosisName != null and diagnosisName != ''">diagnosis_name = #{diagnosisName}, </if>
            <if test="confidence != null">confidence = #{confidence}, </if>
            <if test="riskLevel != null and riskLevel != ''">risk_level = #{riskLevel}, </if>
            <if test="diagnosisBasis != null">diagnosis_basis = #{diagnosisBasis}, </if>
            <if test="knowledgeId != null">knowledge_id = #{knowledgeId}, </if>
            <if test="status != null and status != ''">status = #{status}, </if>
            <if test="remark != null">remark = #{remark}, </if>
            <if test="updateBy != null and updateBy != ''">update_by = #{updateBy}, </if>
            update_time = sysdate()
        </set>
        where preset_id = #{presetId}
    </update>

    <delete id="deleteTzImagePresetById" parameterType="Long">
        delete from tz_image_preset where preset_id = #{presetId}
    </delete>

    <delete id="deleteTzImagePresetByIds" parameterType="Long">
        delete from tz_image_preset where preset_id in
        <foreach item="presetId" collection="array" open="(" separator="," close=")">
            #{presetId}
        </foreach>
    </delete>

</mapper>
