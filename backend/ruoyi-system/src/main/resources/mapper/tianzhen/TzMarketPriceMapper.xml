<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.system.mapper.TzMarketPriceMapper">

    <resultMap type="TzMarketPrice" id="TzMarketPriceResult">
        <result property="priceId"      column="price_id"      />
        <result property="cropType"     column="crop_type"     />
        <result property="variety"      column="variety"       />
        <result property="priceType"    column="price_type"    />
        <result property="region"       column="region"        />
        <result property="price"        column="price"         />
        <result property="priceUnit"    column="price_unit"    />
        <result property="changeRate"   column="change_rate"   />
        <result property="priceDate"    column="price_date"    />
        <result property="source"       column="source"        />
        <result property="createBy"     column="create_by"     />
        <result property="createTime"   column="create_time"   />
        <result property="updateBy"     column="update_by"     />
        <result property="updateTime"   column="update_time"   />
        <result property="remark"       column="remark"        />
    </resultMap>

    <sql id="selectTzMarketPriceVo">
        select price_id, crop_type, variety, price_type, region, price, price_unit, change_rate,
               price_date, source, create_by, create_time, update_by, update_time, remark, company_id, dept_id
        from tz_market_price
    </sql>
    <!--
      公司隔离片段。companyId 由 Service 用 TzCompanyContext 填好：
        · 普通用户 → 自己的 company_id，这里拼上等值条件
        · 超级管理员 → null，条件跳过，看全量（与若依 data_scope=1 一致）
        · 未加入公司 → NO_COMPANY(-1)，命中不到任何行，列表为空
    -->
    <sql id="companyScope">
        <if test="companyId != null">
            AND company_id = #{companyId}
        </if>
    </sql>


    <select id="selectTzMarketPriceById" parameterType="Long" resultMap="TzMarketPriceResult">
        <include refid="selectTzMarketPriceVo"/>
        where price_id = #{priceId}
    </select>

    <select id="selectTzMarketPriceList" parameterType="TzMarketPrice" resultMap="TzMarketPriceResult">
        <include refid="selectTzMarketPriceVo"/>
        <where>
            <if test="cropType != null and cropType != ''">
                AND crop_type = #{cropType}
            </if>
            <if test="variety != null and variety != ''">
                AND variety like concat('%', #{variety}, '%')
            </if>
            <if test="priceType != null and priceType != ''">
                AND price_type = #{priceType}
            </if>
            <if test="region != null and region != ''">
                AND region like concat('%', #{region}, '%')
            </if>
            <if test="priceDate != null">
                AND price_date = #{priceDate}
            </if>
            <if test="source != null and source != ''">
                AND source like concat('%', #{source}, '%')
            </if>
                    <include refid="companyScope"/>
        </where>
        order by price_date desc, price_id desc
    </select>

    <insert id="insertTzMarketPrice" parameterType="TzMarketPrice" useGeneratedKeys="true" keyProperty="priceId">
        insert into tz_market_price (
            <if test="cropType != null and cropType != ''">crop_type, </if>
            <if test="variety != null and variety != ''">variety, </if>
            <if test="priceType != null and priceType != ''">price_type, </if>
            <if test="region != null and region != ''">region, </if>
            <if test="price != null">price, </if>
            <if test="priceUnit != null and priceUnit != ''">price_unit, </if>
            <if test="changeRate != null">change_rate, </if>
            <if test="priceDate != null">price_date, </if>
            <if test="source != null and source != ''">source, </if>
            <if test="remark != null and remark != ''">remark, </if>
            <if test="createBy != null and createBy != ''">create_by, </if>
            <if test="companyId != null">company_id, </if>
            <if test="deptId != null">dept_id, </if>
            create_time
        )values(
            <if test="cropType != null and cropType != ''">#{cropType}, </if>
            <if test="variety != null and variety != ''">#{variety}, </if>
            <if test="priceType != null and priceType != ''">#{priceType}, </if>
            <if test="region != null and region != ''">#{region}, </if>
            <if test="price != null">#{price}, </if>
            <if test="priceUnit != null and priceUnit != ''">#{priceUnit}, </if>
            <if test="changeRate != null">#{changeRate}, </if>
            <if test="priceDate != null">#{priceDate}, </if>
            <if test="source != null and source != ''">#{source}, </if>
            <if test="remark != null and remark != ''">#{remark}, </if>
            <if test="createBy != null and createBy != ''">#{createBy}, </if>
            <if test="companyId != null">#{companyId}, </if>
            <if test="deptId != null">#{deptId}, </if>
            sysdate()
        )
    </insert>

    <update id="updateTzMarketPrice" parameterType="TzMarketPrice">
        update tz_market_price
        <set>
            <if test="cropType != null and cropType != ''">crop_type = #{cropType}, </if>
            <if test="variety != null">variety = #{variety}, </if>
            <if test="priceType != null and priceType != ''">price_type = #{priceType}, </if>
            <if test="region != null">region = #{region}, </if>
            <if test="price != null">price = #{price}, </if>
            <if test="priceUnit != null">price_unit = #{priceUnit}, </if>
            <if test="changeRate != null">change_rate = #{changeRate}, </if>
            <if test="priceDate != null">price_date = #{priceDate}, </if>
            <if test="source != null and source != ''">source = #{source}, </if>
            <if test="remark != null">remark = #{remark}, </if>
            <if test="updateBy != null and updateBy != ''">update_by = #{updateBy}, </if>
            update_time = sysdate()
        </set>
        where price_id = #{priceId}
    </update>

    <delete id="deleteTzMarketPriceById" parameterType="Long">
        delete from tz_market_price where price_id = #{priceId}
    </delete>

    <delete id="deleteTzMarketPriceByIds" parameterType="Long">
        delete from tz_market_price where price_id in
        <foreach item="priceId" collection="array" open="(" separator="," close=")">
            #{priceId}
        </foreach>
    </delete>

</mapper>
