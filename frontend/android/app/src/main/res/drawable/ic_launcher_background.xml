<?xml version="1.0" encoding="utf-8"?>
<!--
  自适应图标的背景层。

  Capacitor 生成的默认值是一整块青色 #26A69A 加一层 10dp 网格线，从建项目起
  就没改过。现在品牌图本身是「白色卡片 + 绿色渐变图形」，所以背景层用纯白，
  图形由 ic_launcher_foreground.png 提供 —— 两层合成后与应用图完全一致。

  注意：XML 注释里不能出现连续两个短横线，所以这里不写带前缀的变量名 ——
  之前就是因为在注释里写了带短横线前缀的变量名，导致 mergeReleaseResources 直接失败。
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportHeight="108"
    android:viewportWidth="108">
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M0,0h108v108h-108z" />
</vector>
