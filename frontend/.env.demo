# ---------------------------------------------------------------- 离线演示构建
#
# 用法：npm run build:demo
# 产物：dist/index.html —— 单个文件，双击即可演示，不需要后端、数据库或 Node。
#
# 与生产构建的差别只有三点：接口改走浏览器内的模拟层、路由换成 hash 模式、
# 所有资源内联进一个 HTML。业务代码完全一致。

# 标题里标明是演示版，免得被当成正式环境
VITE_APP_TITLE = 田诊助手（离线演示）

VITE_APP_ENV = 'production'

# 打开离线演示：main.js 据此装上本地接口模拟。
# 不设这一项时它是 undefined，相关代码会被构建工具整段剔除。
VITE_DEMO = true

VITE_APP_BASE_API = '/prod-api'

# 刻意不设 VITE_BUILD_COMPRESS：单文件构建不需要 gzip 预压缩，
# 整个产物就是一个 HTML，没有再拆分的静态资源。
