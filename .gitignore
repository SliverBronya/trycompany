# ============================================================================
# 田诊助手 .gitignore
# ============================================================================

# ---------------------------------------------------------------- 构建产物
target/
dist/
*.jar
*.war
*.class

# ---------------------------------------------------------------- 依赖
node_modules/

# ---------------------------------------------------------------- 运行时目录
# logs/ 里是后端、前端、MySQL、Redis、ngrok 的运行日志，每次启动都会重写，
# 而且 ngrok-agent.log 里带着隧道信息，没有任何入库价值
logs/
*.log
*.rdb

# 上传的文件由运行时产生，不入库（本机实际在 D:/ruoyi/uploadPath，这里兜一层）
uploadPath/
profile/

# ---------------------------------------------------------------- IDE / 编辑器
.idea/
*.iml
*.iws
.vscode/
.settings/
.project
.classpath
.DS_Store
Thumbs.db

# ---------------------------------------------------------------- 本地环境变量
# 大模型 API Key 一律走 TZ_AI_API_KEY 环境变量，绝不落盘
.env
.env.local
.env.*.local
*.local

# ---------------------------------------------------------------- 本机部署参数
# 数据源口令属于部署参数，不该跟代码一起走。仓库里只有 .example 模板，
# 真实文件只存在于各自本机（首次部署时照模板复制一份）。
application-druid.yml

# 脚本读取的本机口令（test-api.py / seed-demo.py / check-env.ps1）
scripts/.secrets.local

# ---------------------------------------------------------------- Android 打包
# 签名口令与 SDK 路径都跟本机环境绑定，不能进版本库。
# 密钥本体也不在项目里（放在 C:\RuoYi\android-keystore\），
# 避免被打进交付压缩包。
frontend/android/keystore.properties
frontend/android/local.properties
frontend/android/app/*.jks
frontend/android/app/*.keystore
*.jks
*.keystore
# Gradle 与 Android 构建产物
frontend/android/.gradle/
frontend/android/build/
frontend/android/app/build/
frontend/android/capacitor-cordova-android-plugins/build/
frontend/android/app/src/main/assets/public/
.gradle/

# ---------------------------------------------------------------- 临时草稿
# 宿主工具生成的中间产物目录（随机 hash 命名），不是项目代码
draft_*/
_archive/

# ---------------------------------------------------------------- 测试与覆盖率
surefire-reports/
*.dump
*.dumpstream
